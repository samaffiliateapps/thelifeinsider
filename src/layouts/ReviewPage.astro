---
import Base from "./Base.astro";
import ProductCard from "../components/ProductCard.astro";
import EmailCapture from "../components/EmailCapture.astro";
import StickyCta from "../components/StickyCta.astro";
import ExitOffer from "../components/ExitOffer.astro";
import type { Product } from "../components/ProductCard.astro";

export interface Props {
  title: string;
  description: string;
  h1: string;
  updated: string;
  intro: string[]; // paragraphs
  listLede?: string; // one line between the trust strip and the #1 card
  products: Product[];
  deepDive?: { heading: string; body: string[] }; // deep-dive on #1 pick
  faqs?: { q: string; a: string }[];
  highlights?: { title: string; text: string }[]; // 3 key strengths of the #1 pick
  editorial?: { heading: string; html: string }; // long-form editorial sell (our voice, never a persona)
  // 3 headline numbers shown above the list. REAL published specs only — never invented test results.
  keyFindings?: { value: string; label: string }[];
}

const { title, description, h1, updated, intro, listLede, products, deepDive, faqs, highlights, editorial, keyFindings } =
  Astro.props;
const top = products.find((p) => p.rank === 1);

/* Build date is the server-rendered fallback; a small inline script below
   rolls it to the visitor's own current date on load (Sam's call, 11 Aug).
   Rendered in the reader's locale so a US visitor sees a US-formatted date.
   To make the printed date literally true, add a daily scheduled deploy in
   Cloudflare Pages — the page then really is republished every day. */
const publishedOn = new Date().toLocaleDateString("en-AU", {
  day: "numeric", month: "long", year: "numeric", timeZone: "Australia/Brisbane",
});
---

<Base title={title} description={description}>
  <article>
    <!-- Header -->
    <section class="section section-head">
      <div class="container">
        <div class="kicker">Buying Guide</div>
        <h1>{h1}</h1>
        <p class="updated">Last updated: <span id="lastUpdated">{publishedOn}</span></p>

        {/* ORDER CHANGED 10 Aug 2026: intro copy now sits ABOVE the #1 card.
            The card was the first thing on the screen, which handed the reader
            a button before a reason — engage rate 93% against 12% click-through
            says they were reading and leaving, not failing to find the CTA.
            Every competitor funnel running this offer profitably puts 150-200
            words of problem-first copy ahead of the first card. The sticky bar
            still covers anyone convinced later. */}
        <div class="prose intro-lede" style="max-width:820px;">
          {intro.map((para) => <p set:html={para} />)}
        </div>

        {/* Trust strip — derived from the #1 pick's own trustNote so every
            future page inherits it without extra wiring. */}
        {top?.trustNote && (
          <div class="trust-strip">
            {top.trustNote.split("·").map((item) => (
              <span class="ts-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m20 6-11 11-5-5" />
                </svg>
                {item.trim()}
              </span>
            ))}
          </div>
        )}

        {listLede && <p class="list-lede" set:html={listLede} />}

        {/* ANSWER STRIP REMOVED 11 Aug 2026. The #1 pick was appearing as a
            card three times before the advertorial — answer strip, first card
            in the list, then the repeat band — plus the sticky bar and the exit
            offer. Five surfaces for one product reads as pressure, not
            confidence. Both funnels running this offer profitably show it
            twice: once at the top of the list, once again before the sales
            letter. The full card is also the stronger unit; the strip was a
            summary of it sitting directly above it. */}

      </div>
    </section>

    <!-- Key findings: three real, verifiable numbers up front -->
    {keyFindings && keyFindings.length > 0 && (
      <section style="padding:0 0 8px;">
        <div class="container">
          <div class="key-findings">
            <div class="kf-head">Key Findings</div>
            <div class="kf-grid">
              {keyFindings.map((k) => (
                <div class="kf-item">
                  <div class="kf-value">{k.value}</div>
                  <div class="kf-label">{k.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Quick-picks jump list removed with the answer strip — it sat between
        the reader and the #1 card doing a navigation job nobody asked for on a
        five-item page. */}

    <!-- Ranked list. Top 3 shown; the rest sit behind a disclosure so the page
         reaches the #1 pick faster and doesn't front-load choice paralysis. -->
    <section class="section section-list">
      <div class="container">
        {products.slice(0, 3).map((p) => <ProductCard product={p} />)}
        {products.length > 3 && (
          <details class="more-picks">
            <summary>
              <span class="mp-closed">See the rest of the list ({products.length - 3} more)</span>
              <span class="mp-open">Hide the rest of the list</span>
            </summary>
            <div class="mp-body">
              {products.slice(3).map((p) => <ProductCard product={p} />)}
            </div>
          </details>
        )}
      </div>
    </section>

    <!-- Best option on the market: repeat the #1 pick + its key strengths -->
    {top && (
      <section class="section" style="padding-top:0;">
        <div class="container">
          <div class="best-band">The Best Option on the Market</div>
          <ProductCard product={top} repeat />
          {highlights && highlights.length > 0 && (
            <div class="highlights">
              {highlights.map((h, i) => (
                <div class="highlight">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {i === 0 && (
                      <>
                        <path d="M9 3v6M15 3v6" />
                        <path d="M6 9h12v3a6 6 0 0 1-12 0z" />
                        <path d="M12 18v3" />
                      </>
                    )}
                    {i === 1 && (
                      <>
                        <path d="M5 8h9a4 4 0 0 1 0 8H8" />
                        <path d="m10 13-2 3 2 3" />
                        <circle cx="18" cy="6" r="2" />
                      </>
                    )}
                    {i === 2 && <path d="M13 2 4 14h7l-1 8 9-12h-7z" />}
                  </svg>
                  <div>
                    <div class="h-title">{h.title}</div>
                    <div class="h-text">{h.text}</div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Deep dive on #1 -->
    {deepDive && top && (
      <section class="section section-soft">
        <div class="container-narrow prose">
          <div class="kicker">Our #1 Pick</div>
          <h2>{deepDive.heading}</h2>
          {deepDive.body.map((para) => <p set:html={para} />)}
          <div style="text-align:center;margin-top:24px;">
            <a href={top.url} class="btn" rel="sponsored nofollow noopener" target="_blank">
              Visit Site
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Long-form editorial sell -->
    {editorial && top && (
      <section class="section" style="padding-top:0;">
        <div class="container-narrow prose">
          <h2>{editorial.heading}</h2>
          <div set:html={editorial.html} />
          <div style="text-align:center;margin:30px 0 0;">
            <a href={top.url} class="btn" rel="sponsored nofollow noopener" target="_blank">
              Visit Site
            </a>
            {top.discount && <div class="rank-offer" style="margin-top:8px;">{top.discount}</div>}
          </div>
        </div>
      </section>
    )}

    <!-- Email capture -->
    <EmailCapture />

    <!-- FAQ -->
    {faqs && faqs.length > 0 && (
      <section class="section" id="faq">
        <div class="container-narrow">
          <h2 style="margin-bottom:20px;">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-q">{f.q}</span>
                  <svg class="faq-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <div class="faq-a"><p set:html={f.a} /></div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section" style="padding-top:0;">
      <div class="container-narrow">
        <p class="disclosure-line" style="text-align:center;margin:0;">
          Reader-supported: we may earn a commission when you buy through our
          links, at no extra cost to you — it never affects our{" "}
          <a href="/how-we-rate/">verified-data scores</a>. See our{" "}
          <a href="/advertising-disclosure/">Advertising Disclosure</a>.
        </p>
      </div>
    </section>
  </article>

  {top && (
    <StickyCta
      name={top.name}
      brand={top.brand}
      image={top.stickyImage ?? top.image}
      url={top.url}
      price={top.price}
      oldPrice={top.oldPrice}
      discount={top.discount}
      ctaLabel={top.ctaLabel}
    />
  )}

  <script is:inline>
    /* Roll "Last updated" to the reader's current date. Server-rendered build
       date stays as the no-JS fallback. */
    (function () {
      var el = document.getElementById("lastUpdated");
      if (!el) return;
      try {
        el.textContent = new Date().toLocaleDateString(undefined, {
          day: "numeric", month: "long", year: "numeric",
        });
      } catch (e) {}
    })();
  </script>

  {top && (
    <ExitOffer
      name={top.name}
      image={top.image}
      url={top.url}
      price={top.price}
      oldPrice={top.oldPrice}
      discount={top.discount}
      trustNote={top.trustNote}
    />
  )}

  {/* Forward page-level tracker scripts through to Base */}
  <slot name="body-end" slot="body-end" />
</Base>
