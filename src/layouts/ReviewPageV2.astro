---
/* REVIEW PAGE V2 — 4 Sep 2026.
   The proven affiliate-lander shape, section for section, from the visual
   teardown of eight high-traffic competitor pages (competitor-visual-teardown-3sep.md):
   logo-only header → H1 + "Last Updated" → bold sub-headline → pain questions →
   short intro → #1 card (big) → rivals (compact, 2 shown, rest behind a toggle) →
   repeat band + #1 card with trust strip → HOW WE RATE box → two-column editorial
   with a STICKY sub-score sidebar → urgency box + wide CTA → customer quotes →
   where to buy → final score card + author → FAQ → email capture → disclosure.
   Sticky bottom bar and exit offer retained from V1. */
import "../styles/v2.css";
import Base from "./Base.astro";
import RankCardV2 from "../components/RankCardV2.astro";
import type { ProductV2 } from "../components/RankCardV2.astro";
import EmailCapture from "../components/EmailCapture.astro";
import StickyCta from "../components/StickyCta.astro";
import ExitOffer from "../components/ExitOffer.astro";
import fs from "node:fs";
import path from "node:path";

export interface Props {
  title: string;
  description: string;
  h1: string;
  subhead: string;                 // one bold sentence under the date
  painQuestions: string[];         // 3–5 bold questions
  intro: string[];                 // 2–3 short paragraphs
  listLede: string;
  products: ProductV2[];
  trust: string[];                 // 3 items in the repeat card's trust strip
  howWeRate?: string;              // optional — omitted on Grounded (Sam, 4 Sep)
  editorial: { heading: string; byline: string; bylineRole?: string; html: string };
  sidebar: { subscores: { label: string; value: number }[]; pros: string[]; cons: string[] };
  urgency: { kicker: string; heading: string; text: string; cta: string; under?: string };
  quotes: { text: string; name: string; where?: string; source: string; stars?: number }[];
  howToBuy: { title: string; text: string }[];
  author: { name: string; role: string; bio: string; photo?: string };
  faqs?: { q: string; a: string }[];
  visibleRivals?: number;          // rivals shown before the toggle (default 2)
  /* ---- 19 Oct 2026 (GOOGLE-PAGES-BLUEPRINT §3/§6.3). All optional: older pages render unchanged. ---- */
  updated?: string;                // fixed real edit date ("October 19, 2026"); when set, dates no longer roll to "today"
  topByline?: { name: string; role: string };  // byline in the first screen, under the H1
  verdict?: {                      // verdict box in the first mobile screen
    kicker: string; name: string; image?: string; score: number; ratingLine?: string;
    line: string; price: string; oldPrice?: string; bundle?: string; facts: string[]; cta: string; stock?: string;
  };
  compareTable?: { title: string; intro?: string; columns: string[]; rows: { cells: string[]; top?: boolean }[]; note?: string };
  dealCalendar?: { label: string; startISO: string; endISO: string; timer?: boolean }[]; // merchant's own sale calendar (local time, as the merchant's banner computes it)
  bandLabel?: string;              // repeat-band text override
  stickyButton?: string;           // sticky bar button text
  disclosure?: string;             // html; overrides the default disclosure paragraph
}
const { title, description, h1, subhead, painQuestions, intro, listLede, products, trust, howWeRate, editorial, sidebar, urgency, quotes, howToBuy, author, faqs, visibleRivals = 2, updated, topByline, verdict, compareTable, dealCalendar, bandLabel, stickyButton, disclosure } = Astro.props;
/* Build-time fallback for the deal label/clock (the inline script replaces it on load). */
const nowBuild = new Date();
const activeSale = dealCalendar?.find((d) => nowBuild >= new Date(d.startISO) && nowBuild <= new Date(d.endISO));
const saleLabel = activeSale?.label ?? "Today's Offer";
const saleWhen = activeSale && activeSale.timer !== false ? `ends ${new Date(activeSale.endISO).toLocaleDateString("en-US", { month: "short", day: "numeric" })}` : "on now";
const top = products.find((p) => p.rank === 1)!;
const rivals = products.filter((p) => p.rank !== 1).sort((a, b) => a.rank - b.rank);
const shown = rivals.slice(0, visibleRivals);
const hidden = rivals.slice(visibleRivals);
const publishedOn = updated ?? new Date().toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "America/New_York" });
const stars = top.starRating ? "★".repeat(Math.round(top.starRating)) + "☆".repeat(5 - Math.round(top.starRating)) : null;
const initials = author.name.split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase();
const photoOk = author.photo ? fs.existsSync(path.join(process.cwd(), "public", author.photo)) : false; // build-time check from the project root
---

<Base title={title} description={description} minimal>
  <article class="v2">
    <div class="container">
      <!-- 1. Header -->
      <header class="v2-head">
        <h1>{h1}</h1>
        <div class="v2-updated">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.2-4-4 1.4-1.4 2.6 2.6 5.6-5.6 1.4 1.4-7 7Z" /></svg>
          Last Updated: <span id="lastUpdated">{publishedOn}</span>
        </div>
        {topByline && (
          <p class="v2-topbyline">By <strong>{topByline.name}</strong>, {topByline.role}</p>
        )}
        {verdict && (
          <div class="v2-verdict" id="verdict">
            <div class="vd-kicker">{verdict.kicker}</div>
            <div class="vd-row">
              {verdict.image && <img class="vd-img" src={verdict.image} alt={verdict.name} width="96" height="88" loading="eager" decoding="async" />}
              <div class="vd-main">
                <div class="vd-name">{verdict.name}</div>
                <div class="vd-score"><span class="vd-num">{verdict.score.toFixed(1)}</span><span class="vd-of">/10</span> <span class="vd-stars">★★★★★</span></div>
                {verdict.ratingLine && <div class="vd-rating">{verdict.ratingLine}</div>}
              </div>
            </div>
            <p class="vd-line" set:html={verdict.line} />
            <div class="vd-price"><span class="now">{verdict.price}</span>{verdict.oldPrice && <span class="was">{verdict.oldPrice}</span>}{verdict.bundle && <span class="bundle" set:html={verdict.bundle} />}</div>
            <ul class="vd-facts">{verdict.facts.map((f) => <li set:html={f} />)}</ul>
            {dealCalendar && (
              <div class="vd-deal"><strong data-deal-label>{saleLabel}</strong>: up to 60% off · <span class="deal-clock" data-deal-when>{saleWhen}</span>{verdict.stock && <span class="vd-stock" set:html={verdict.stock} />}</div>
            )}
            <a href={top.url} class="v2-btn vd-btn" rel="sponsored nofollow noopener" target="_blank" data-cta="verdict">{verdict.cta}</a>
          </div>
        )}
        <p class="v2-subhead" set:html={subhead} />
        <div class="v2-pain">{painQuestions.map((q) => <p set:html={q} />)}</div>
        <div class="v2-intro">{intro.map((t) => <p set:html={t} />)}</div>
        {compareTable && (
          <section class="v2-compare" id="compare">
            <h2 class="v2-section-title" style="margin-top:18px;" set:html={compareTable.title} />
            {compareTable.intro && <p class="cmp-intro" set:html={compareTable.intro} />}
            <div class="cmp-wrap">
              <table class="cmp">
                <thead><tr>{compareTable.columns.map((c) => <th scope="col" set:html={c} />)}</tr></thead>
                <tbody>
                  {compareTable.rows.map((r) => (
                    <tr class:list={{ "is-top": r.top }}>{r.cells.map((c, i) => (i === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />))}</tr>
                  ))}
                </tbody>
              </table>
            </div>
            {compareTable.note && <p class="cmp-note" set:html={compareTable.note} />}
          </section>
        )}
        <p class="v2-list-lede" set:html={listLede} />
      </header>

      <!-- 2. #1 card -->
      <RankCardV2 product={top} />

      <!-- 3. Rivals -->
      {shown.map((p) => <RankCardV2 product={p} />)}
      {hidden.length > 0 && (
        <details class="v2-more">
          <summary>
            <span class="mo-closed">See the rest of the list ({hidden.length} more) ⌄</span>
            <span class="mo-open">Hide the rest of the list ⌃</span>
          </summary>
          <div class="mo-body">{hidden.map((p) => <RankCardV2 product={p} />)}</div>
        </details>
      )}

      <!-- 4. Repeat band + #1 with trust strip -->
      <div class="v2-band">{bandLabel ?? <>Best Overall {h1.replace(/^The \d+ Best /i, "").replace(/ of \d{4}$/i, "")} — {new Date().getFullYear()}</>}</div>
      <RankCardV2 product={top} repeat trust={trust} />

      {howWeRate && (
        <div class="v2-note">
          <div class="n-head">How We Rate?</div>
          <p set:html={howWeRate} />
        </div>
      )}

      <!-- 6. Editorial + sticky sidebar -->
      <div class="v2-ed">
        <div class="v2-ed-main">
          <h2 set:html={editorial.heading} />
          <p class="v2-byline">Written by <strong>{editorial.byline}</strong>{editorial.bylineRole && <>, {editorial.bylineRole}</>} — Updated <span data-updated>{publishedOn}</span></p>
          <div class="prose" set:html={editorial.html} />

          <!-- 7. Urgency + wide CTA -->
          <div class="v2-urgent">
            <div class="u-kicker">{urgency.kicker}</div>
            <h3 set:html={urgency.heading} />
            <p set:html={urgency.text} />
          </div>
          <a href={top.url} class="v2-wide-btn" rel="sponsored nofollow noopener" target="_blank">{urgency.cta}</a>
          {urgency.under && <p class="v2-under-btn" set:html={urgency.under} />}
        </div>

        <aside class="v2-ed-side">
          <div class="side-card">
            <div class="sc-head">Overall Score</div>
            <div class="sc-score">{top.score.toFixed(1)}</div>
            <div class="sc-label">{top.scoreLabel}</div>
            {stars && <div class="sc-stars">{stars}</div>}
            {top.ratingLine && <div class="sc-rating">{top.ratingLine}</div>}
            {sidebar.subscores.map((s) => (
              <div class="bar">
                <div class="bl"><span>{s.label}</span><span>{s.value.toFixed(1)}</span></div>
                <div class="bt"><div class="bf" style={`width:${s.value * 10}%`}></div></div>
              </div>
            ))}
            <div class="sc-pc">
              <div class="pc-head pros">PROS:</div>
              <ul>{sidebar.pros.map((t) => <li set:html={t} />)}</ul>
              <div class="pc-head cons">CONS:</div>
              <ul>{sidebar.cons.map((t) => <li class="x" set:html={t} />)}</ul>
            </div>
            <a href={top.url} class="v2-btn" rel="sponsored nofollow noopener" target="_blank">Visit Site →</a>
          </div>
        </aside>
      </div>

      <!-- 8. Customer quotes -->
      <h2 class="v2-section-title">What {top.brand ?? top.name} Customers Say</h2>
      <p style="margin:0;color:var(--muted);font-size:0.9rem;">Verbatim from {top.brand ?? top.name}'s published customer reviews. Individual experiences vary.</p>
      <div class="v2-quotes">
        {quotes.map((q) => (
          <div class="quote">
            <div class="q-stars">{"★".repeat(q.stars ?? 5)}</div>
            <p set:html={`“${q.text}”`} />
            <div class="q-who">{q.name}{q.where && <> — {q.where}</>}</div>
            <div class="q-src">{q.source}</div>
          </div>
        ))}
      </div>

      <!-- 9. Where to buy -->
      <h2 class="v2-section-title">Where Can I Buy the {top.name}?</h2>
      <ol class="v2-steps">{howToBuy.map((s) => <li><div><div class="st">{s.title}</div><p class="sb" set:html={s.text} /></div></li>)}</ol>
      <div style="text-align:center;margin-top:18px;">
        <a href={top.url} class="v2-btn" style="display:inline-block;width:auto;max-width:none;padding:14px 34px;" rel="sponsored nofollow noopener" target="_blank">{urgency.cta}</a>
      </div>

      <!-- 10. Author -->
      <div class="v2-final">
        <div class="v2-author">
          {photoOk ? <img class="av" src={author.photo} alt={author.name} width="64" height="64" loading="lazy" /> : <div class="av">{initials}</div>}
          <div>
            <div class="an">Written by {author.name}</div>
            <div class="ar">{author.role}</div>
            <p set:html={author.bio} />
          </div>
        </div>
      </div>

      <!-- 11. FAQ -->
      {faqs && faqs.length > 0 && (
        <section id="faq" style="margin-top:34px;">
          <h2 class="v2-section-title" style="margin-top:0;">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-q">{f.q}</span>
                  <svg class="faq-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="faq-a"><p set:html={f.a} /></div>
              </details>
            ))}
          </div>
        </section>
      )}

      <details class="v2-disclosure">
        <summary>Advertising disclosure</summary>
        {disclosure ? <p set:html={disclosure} /> : <p>The Life Insider is reader-supported. We earn a commission from some links on this page, at no extra cost to you; this may affect which products we feature and in what order — see <a href="/how-we-rate/">how we rate</a> and our <a href="/advertising-disclosure/">advertising disclosure</a>. Product claims are the brand's own and are attributed as such. This page is not medical advice.</p>}
      </details>
    </div>

    <EmailCapture />
  </article>

  <StickyCta name={top.name} brand={top.brand} image={top.stickyImage ?? top.image} url={top.url} price={top.price} oldPrice={top.oldPrice} discount={top.discount} ctaLabel={top.ctaLabel} buttonText={stickyButton} ctaId="sticky" />
  <ExitOffer name={top.name} image={top.image} url={top.url} price={top.price} oldPrice={top.oldPrice} discount={top.discount} trustNote={top.trustNote} />

  {dealCalendar && (
    <script is:inline define:vars={{ dealCalendar }}>
      /* Merchant sale calendar (19 Oct 2026): label + live countdown to the REAL end date of the
         sale the merchant's own banner shows today. Local time, exactly as the merchant computes it. */
      (function () {
        function parse(s) { var p = s.split(/[-T:]/).map(Number); return new Date(p[0], p[1] - 1, p[2], p[3] || 0, p[4] || 0, p[5] || 0); }
        function pad(n) { return (n < 10 ? "0" : "") + n; }
        function current() {
          var now = new Date();
          for (var i = 0; i < dealCalendar.length; i++) {
            var d = dealCalendar[i];
            if (now >= parse(d.startISO) && now <= parse(d.endISO)) return { label: d.label, end: parse(d.endISO), timer: d.timer !== false };
          }
          return null;
        }
        function tick() {
          var s = current();
          var labels = document.querySelectorAll("[data-deal-label]");
          var clocks = document.querySelectorAll("[data-deal-timer]");
          var ends = document.querySelectorAll("[data-deal-end]");
          var whens = document.querySelectorAll("[data-deal-when]");
          if (!s || !s.timer) {
            /* No named sale with a real end date right now (the merchant shows no timer either): label only, no clock. */
            labels.forEach(function (n) { n.textContent = s ? s.label : "Today's Offer"; });
            whens.forEach(function (n) { n.textContent = "on now"; });
            return;
          }
          var ms = Math.max(0, s.end - new Date());
          var t = Math.floor(ms / 1000), dd = Math.floor(t / 86400), hh = Math.floor((t % 86400) / 3600), mm = Math.floor((t % 3600) / 60), ss = t % 60;
          var txt = (dd > 0 ? dd + "d " : "") + pad(hh) + ":" + pad(mm) + ":" + pad(ss);
          labels.forEach(function (n) { n.textContent = s.label; });
          clocks.forEach(function (n) { n.textContent = txt; });
          whens.forEach(function (n) { n.textContent = "ends in " + txt; });
          var endTxt = s.end.toLocaleDateString("en-US", { month: "long", day: "numeric" });
          ends.forEach(function (n) { n.textContent = endTxt; });
        }
        try { tick(); setInterval(tick, 1000); } catch (e) {}
      })();
    </script>
  )}

  <script is:inline define:vars={{ fixedDate: updated ?? "" }}>
    /* Roll every date on the page to the reader's own current date (US locale) — only on pages without a fixed `updated` date. */
    if (!fixedDate) (function () {
      try {
        var d = new Date().toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "America/New_York" });
        var el = document.getElementById("lastUpdated"); if (el) el.textContent = d;
        document.querySelectorAll("[data-deal-date],[data-updated]").forEach(function (n) { n.textContent = d; });
      } catch (e) {}
    })();
  </script>

  <slot name="body-end" slot="body-end" />
</Base>
