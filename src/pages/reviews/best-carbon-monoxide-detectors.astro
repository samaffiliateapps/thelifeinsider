const faqs = [
  {
    q: "How much carbon monoxide is normal?",
    a: "In a healthy home, essentially zero. Readings of 0 to 9 PPM are considered normal background. Anything sustained between 10 and 30 PPM is worth investigating — that band usually points at a dirty oven, a flue that is not drawing properly, or a cracked heat exchanger. Above 30 PPM you should be opening windows and getting the appliance looked at. The awkward part is that a standard listed alarm is built to display 0 across that entire first two bands, so the range most worth knowing about is the range it will not show you.",
  },
