    trustNote: "30-day money-back guarantee · free size exchanges",
    badge: "Best Overall",
    price: "$69.99",
    oldPrice: "$139.98",
    discount: "50% Off",
    image: "/images/gf-grounded.webp",
    url: GF_LINK,
    ctaLabel: "Check Price & Availability",
