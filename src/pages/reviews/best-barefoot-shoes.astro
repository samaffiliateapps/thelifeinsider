  },
  {
    rank: 5,
    name: "Zureto Grounding Shoes with Copper",
    brand: "Zureto",
    score: 7.6,
    scoreLabel: "Good",
    grade: "B-",
    bestFor: "Best for Grounding Enthusiasts",
    verdict:
      "A barefoot shoe with a copper conductive plug for people who specifically want earthing. Judged purely as a barefoot shoe it sits behind everything above it.",
    metrics: [
      { label: "Toe Box Width", value: 80 },
      { label: "All-Day Comfort", value: 74 },
      { label: "Weight", value: 82 },
      { label: "Value for Money", value: 76 },
      { label: "Buyer Protection", value: 80 },
