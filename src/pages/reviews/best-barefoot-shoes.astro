---
import ReviewPage from "../../layouts/ReviewPage.astro";
import type { Product } from "../../components/ProductCard.astro";

/* =========================================================================
   HERO: Grounded Footwear® Freedom — AdsBranded offer 568, $64 CPA, US.
   Network CVR 8.34%. Top offer on the network, evergreen.

   ECONOMICS (verified 4 Aug 2026)
     EPC to offer = $64 × 8.34% = $5.34 USD
     Break-even CPC = EPC × pass-through
        at 50% -> A$3.84   at 35% -> A$2.69   at 25% -> A$1.92
     Keyword Planner top-of-page LOW on our target set: A$0.37-0.97.
     Profitable even on the pessimistic column — unlike Survival Sip.

   ⚠️ CLAIMS — verified 5 Aug 2026 against the AFFILIATE funnel we send to
   (landing1), not the creative brief and not the D2C store.
   Guarantee correction: the D2C store at groundedfootwear.co shows 30 days,
   but landing1 and landing-new-org both state 90 days — different funnels,
   different terms. We state what the page the buyer actually lands on states.
   Verified on landing1: 90-day money-back · free size exchanges ·
   "up to 60% off" (bundle pricing; $69.99 from $139.98 is the single pair).
   DESTINATION CHOICE: landing1 = 60% off + 90-day guarantee.
   landing1b = 50% off + 30-day. D2C store = 30-day. Three funnels, three
   sets of terms — always read the one you are actually sending to. ·
   zero heel drop · wide anatomical toe box · 60% lighter (their claim) ·
   machine washable · 13,427+ customers (their claim).

   ⚠️ CORRECTION 11 Aug 2026: this file previously recorded "250,000+
   customers" as verified on landing1. It is not on that page and never was —
   re-fetched and grepped the live funnel, and the only customer figure it
   carries is "Based on reviews from 13,427+ customers". The figure had been
   published in the trust strip, the #1 card and the exit offer. Corrected in
   all three. Verify claims against the funnel, not against a note saying the
   funnel was verified.
   Also on landing1 and quotable: "Limited Time: Claim Your 60% Off Today".

   We do NOT repeat the merchant's medical claims. Their presell asserts
   relief for neuropathy, diabetic foot symptoms, circulation and restless
   leg syndrome, and says podiatrists recommend the design. We make none of
   those. We describe the geometry (flat sole, wide toe box) and attribute
   every performance claim to the maker.

   ANGLE: people who are on their feet and in pain — matches the ad groups
   (Wide Toe Box / Plantar Fasciitis & Foot Pain / On Your Feet All Day /
   Bunions) and the offer's own presell reason #3, which names nurses,
   retail workers, teachers, custodians and cashiers explicitly.

   AMAZON: ranks 2-5 resolved from Sam's short links on 4 Aug 2026 and each
   title confirmed against its product page. Two of the four links he sent
   resolved to water shoes / aqua socks (B0FSXWFTZC, B0CTGT4M24) and were
   replaced with genuine barefoot shoes — a water shoe on a foot-pain page
   is incoherent and would have cost us credibility.
   ========================================================================= */

/* ---------------------------------------------------------------------------
   CPV ONE TRACKING — set CPV_CAMPAIGN once the campaign exists in CPV One.
   Until then no tracker scripts are emitted and the hero CTA falls back to
   the direct AdsBranded link, so this page is safe to deploy right now.

   Google Ads Final URL suffix, CAMPAIGN level only:
     keyword={keyword}&ad={creative}&match={matchtype}&network={network}&campid={campaignid}&adgroupid={adgroupid}&clpcid=<ID>

   ⚠️ EVERFLOW — global postback must be set in the AdsBranded panel:
     https://cli-1900.clprdr.com/adclick.php?subid={sub1}&revenue={payout_amount}&txid={transaction_id}
   --------------------------------------------------------------------------- */
const CPV_ROOT = "https://cli-1900.clprdr.com/";
const CPV_ENGSEC = "5"; // install-level, same for every campaign
const CPV_CAMPAIGN = "10"; // Grounded Footwear — CPV One campaign 10

const GF_DIRECT =
  "https://offer.groundedfootwear.co/freedom/en/us/landing1?uid=83&oid=60&affid=23&uid=1722&oidab=568&affidab=1241";
const GF_LINK = CPV_CAMPAIGN ? `${CPV_ROOT}base2.php` : GF_DIRECT;

/* Explicit amazon.com URLs — short links geo-bounce to amazon.com.au and
   strip the tag. ASINs resolved and each product title confirmed. */
const AMZ = (asin: string, sub: string) =>
  `https://www.amazon.com/dp/${asin}?tag=thelifeinside-20&ascsubtag=gf_${sub}&language=en_US`;

const products: Product[] = [
