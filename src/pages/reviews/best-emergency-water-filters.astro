---
import ReviewPage from "../../layouts/ReviewPage.astro";
import type { Product } from "../../components/ProductCard.astro";

/* =========================================================================
   HERO: Survival Sip Pocket Water Filter — AdsBranded, $40 CPA, US.
   Offer ID 1035. Funnel verified 28 Jul 2026: /inter interstitial live.
   Economics: $40 payout. The network quotes 10% CVR; Sam's own estimate is
   4-6% and we plan against that. At 5%: $2.00 EPC -> ~$1.00 revenue per our
   click at 50% pass-through. Break-even CPC $1.00 USD (AUD ~1.44 at 1.44).
   Target CPC for 2x ROAS: $0.50 USD (AUD ~0.72). Re-derive once real CVR lands.

   ANGLE: family preparedness, NOT outdoor/camping. Both the creative brief
   ("'Protect your family' vs competitors' 'outdoor adventure' angle") and the
   offer page itself ("Your Family's Water Lifeline in Any Crisis") use it.

   ⚠️ CLAIMS: every spec on the hero below is the manufacturer's own, taken
   from the offer page, and attributed as such. Two internal inconsistencies
   on their page — hero says 1,800 gallons, comparison table says 1,300; hero
   says 99.99%, table says 99.9999%. We use the CONSERVATIVE figure in both
   cases (1,800 is their headline claim so it is cited as "up to", and 99.99%).

   AMAZON: ranks 2-5 use verified deep links (ASINs resolved from Sam's
   link.amazon short links on 29 Jul 2026 and confirmed against each product
   page). Built against amazon.com explicitly rather than the short links,
   which geo-bounce to amazon.com.au and drop the tag. Still no star ratings
   or review counts: "X verified reviews" is a factual claim we have not
   independently verified, unlike the Insider Score which is our opinion.
   ========================================================================= */

/* ---------------------------------------------------------------------------
   CPV ONE TRACKING — Survival Sip = CPV campaign 9 (HauSafe 5, Mosqinux 7).
   engsec is the install-level token (stays "5" for every campaign).
   Until CPV_CAMPAIGN is set, no tracker scripts are emitted and the hero CTA
   falls back to the direct AdsBranded link, so the page is safe to deploy.

   Google Ads Final URL suffix, CAMPAIGN level only (it pins clpcid):
     keyword={keyword}&ad={creative}&match={matchtype}&network={network}&campid={campaignid}&adgroupid={adgroupid}&clpcid=9

   ⚠️ EVERFLOW — set as a GLOBAL postback in the AdsBranded/Everflow panel, or
   no sale ever reaches CPV One and nothing imports to Google Ads:
     https://cli-1900.clprdr.com/adclick.php?subid={sub1}&revenue={payout_amount}&txid={transaction_id}
   --------------------------------------------------------------------------- */
const CPV_ROOT = "https://cli-1900.clprdr.com/";
const CPV_ENGSEC = "5";
const CPV_CAMPAIGN = "9"; // Survival Sip — CPV One campaign 9

// Traffic goes to the INTERSTITIAL, not straight to checkout: the 10% CVR was
// measured on that funnel, so bypassing it would invalidate the number we bid against.
const SIP_DIRECT = "https://unbindgear.com/survivalsip/inter?oid=159&affid=1&oidab2=1035&affidab2=1241";
const SIP_LINK = CPV_CAMPAIGN ? `${CPV_ROOT}base2.php` : SIP_DIRECT;

// Verified 29 Jul 2026 by resolving Sam's link.amazon short links and reading the
// ASIN off each product page. Built against amazon.com explicitly (not the short
// links) so US traffic can't be geo-bounced and the US tag can't be stripped.
const AMZ = (asin: string, sub: string) =>
  `https://www.amazon.com/dp/${asin}?tag=thelifeinside-20&ascsubtag=sip_${sub}&language=en_US`;

/* Manufacturer-published specs, cited as theirs. */
const keyFindings = [
  { value: "0.1 micron", label: "Hollow-fibre membrane on our top pick" },
  { value: "1,800 gal", label: "Manufacturer's stated filter lifespan" },
  { value: "2 oz", label: "Light enough to forget it is in the bag" },
];

const products: Product[] = [
