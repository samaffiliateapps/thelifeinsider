<ReviewPage
  title="The 5 Best Emergency Water Filters of 2026 [Compared] | The Life Insider"
  description="We compared the best emergency and portable water filters on filtration, ease of use under pressure, family suitability and value. See which filter ranked #1 for 2026."
  h1="The 5 Best Emergency Water Filters of 2026"
  updated="July 2026"
  intro={intro}
  products={products}
  keyFindings={keyFindings}
  highlights={highlights}
  deepDive={deepDive}
  editorial={editorial}
  faqs={faqs}
>
  {CPV_CAMPAIGN && (
    <Fragment slot="body-end">
      <script is:inline set:html={`var clpconfig = { "clroot": "${CPV_ROOT}", "engsec": "${CPV_ENGSEC}" };`} />
      <script is:inline src={`${CPV_ROOT}landing.js`}></script>
