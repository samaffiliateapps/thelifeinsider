/* Real, verifiable product facts only — no invented test results. */
const keyFindings = [
  { value: "500 sq ft", label: "Coverage from a single bulb, indoors or out" },
  { value: "Zero", label: "Chemicals, sprays or refills required" },
  { value: "2 min", label: "Screws into any standard socket — no tools" },
];

const intro = [
  "The right insect zapper is the difference between actually using your backyard on a summer evening and retreating indoors by dusk. But the category is full of overpromises — so before you buy, it helps to know what genuinely works, and for what.",
  "Two honest truths shape the whole category. First, chemical-free devices (UV bulbs, electric grids, and fan traps) are the safer choice around children and pets than sprays and foggers. Second, no single device is best at everything: UV zappers pull in a wide range of flying insects and are perfect for indoor and patio use, while CO2-style traps are the most targeted at mosquitoes specifically over larger outdoor areas. The best pick depends on your space.",
  "We compared each option on coverage area, how it works, verified customer ratings and review volume, noise, and value. Below are the insect zappers and traps worth buying in 2026, ranked by our <a href='/how-we-rate/'>Insider Score</a>.",
];

const deepDive = {
  heading: "Why the Mosqinux Killamp Is Our #1 Pick",
  body: [
    "Most insect killers make you choose: powerful but chemical-heavy, or safe but weak. The Mosqinux Killamp sidesteps that. It's a UV bulb with an electric grid that draws in and eliminates flying insects using no sprays or chemicals at all — which is why it's genuinely safe to run in a bedroom or a nursery, or out on a patio where kids and pets are around.",
    "What makes it our Best Overall is how easy it is to live with. It screws into any standard light socket or plugs into an outlet — no tools, no assembly — covers up to 500 square feet, runs silently, and doubles as a soft night light. That combination of chemical-free, quiet, and effortless is exactly what most people actually want for everyday indoor and patio use.",
    "We'll be straight about the trade-off: like any UV device, it attracts a broad range of flying insects rather than mosquitoes alone, and if your one and only goal is knocking down mosquitoes across a large yard, a dedicated CO2 trap like our #4 pick, the DynaTrap, is more specialized for that. For versatile, chemical-free, plug-in-and-forget insect control — the job most people are actually shopping for — the Mosqinux is the one we'd reach for first.",
  ],
};

const faqs = [
  {
    q: "Do bug zappers actually kill mosquitoes?",
    a: "UV bug zappers attract and kill a wide range of flying insects, and they'll catch mosquitoes too — but mosquitoes hunt primarily by carbon dioxide and body heat, so UV alone isn't the most targeted approach for them. For general flying-insect control (indoors or on a patio) a UV device like our top pick is ideal and chemical-free; for maximum mosquito reduction across a yard, a CO2-mimicking trap is the more specialized tool.",
  },
  {
    q: "Are these safe to use around children and pets?",
    a: "Chemical-free devices — UV bulbs, electric grids, and fan traps — avoid the sprays and fumes of chemical repellents, which makes them a safer choice around kids and pets. As with any electrical device, place it out of small children's reach and follow the safety instructions on the box.",
  },
  {
    q: "Can I use the Mosqinux indoors and outdoors?",
