/>

<style is:global>
  /* Page-scoped (this route only). Mobile-first; 16:9 hero; compact ATF so lead line 1 shows in a ~375×640 FB in-app view. */
  .site-header .container { padding-top: 6px; padding-bottom: 6px; }
  #adv .mast { padding: 8px 0 7px; margin-bottom: 14px; }
  #adv .top-disc { margin: 5px 0 4px; line-height: 1.35; }
