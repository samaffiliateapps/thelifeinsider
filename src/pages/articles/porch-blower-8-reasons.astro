  #adv h1 { font-size: clamp(1.75rem, 7.6vw, 1.95rem); line-height: 1.18; margin: 0 0 12px; letter-spacing: -0.015em; }
  #adv .sub { font-size: 1rem; font-weight: 600; line-height: 1.45; margin: 0 0 12px; color: #2b3445; }
  #adv .byline { font-size: 0.8rem; line-height: 1.45; margin: 0 0 12px; padding-top: 9px; border-top: 1px solid var(--rule); }
  #advHero { margin: 0 0 12px; }
  #adv .rating { gap: 8px; font-size: 0.92rem; margin: -2px 0 12px; }
  #adv .rating .stars { font-size: 1.05rem; letter-spacing: 1px; }
  #adv .rating .r-src { color: var(--muted); font-size: 0.8rem; }
  #advHero img { aspect-ratio: 16 / 9; object-fit: cover; background: #fff; border-radius: 10px; }
  #adv[data-variant="c"] #advHero img { object-position: 50% 45%; }
  @media (min-width: 768px) {
    #adv .mast { margin-bottom: 22px; }
    #adv h1 { font-size: 2.45rem; line-height: 1.16; margin: 0 0 18px; }
    #adv .sub { font-size: 1.2rem; line-height: 1.5; margin: 0 0 18px; }
    #adv .byline { font-size: 0.9rem; margin: 0 0 22px; padding-top: 14px; }
    #advHero { margin: 0 0 16px; }
    #adv #advHeroCap { font-size: 0.9rem !important; margin-top: 8px !important; }
  }
  #adv #advHeroCap { margin-top: 4px; font-size: 0.8rem; line-height: 1.35; }  /* kept small: 0.9rem wraps to 3 lines and leaves 1px of fold at 375x640 */
  #adv figure img { background: #fff; }
  #adv .reason h2 { font-size: 1.5rem; }                 /* 24px: doctrine subheads 24-34px (list.css drops to 1.3rem on phones) */
  #adv figcaption { font-size: 0.9rem; color: var(--ink); line-height: 1.4; }  /* legible for 70-80-year-old readers */
  #adv figure.sq img { max-width: 480px; margin: 0 auto; }
  #adv figure.narrow img { max-width: 360px; }
  #adv .prose p { margin-bottom: 0.9em; }
  #adv .adnote { font-size: 0.78rem; color: var(--muted); margin: 4px 0 0; line-height: 1.35; }
  #adv a.tlink { color: var(--cta); font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  #adv .chip { display: flex; gap: 12px; align-items: center; border: 1px solid var(--rule); border-radius: 12px; padding: 10px 12px; margin: 1.1em 0 0.4em; background: var(--bg-soft); }
  #adv .chip img { width: 84px; height: 84px; flex: none; object-fit: cover; border-radius: 8px; background: #fff; }
  #adv .chip-t p { margin: 0; font-size: 0.95rem; line-height: 1.4; }
  #adv .chip-t .chip-link { margin-top: 4px; font-size: 1.02rem; }
  #adv .chip-t .chip-rate { margin-top: 2px; font-size: 0.88rem; color: var(--muted); }
  #adv .chip-t .chip-rate .st { color: #f5a623; letter-spacing: 1px; }
  #adv .cta a.btn { line-height: 1.3; }
  #adv .ctabox { border: 2px solid var(--frame); border-radius: 12px; padding: 14px 14px 10px; background: #f6fdf8; }
  #adv .cta .under { font-size: 0.86rem; color: var(--muted); margin: 8px 0 0; line-height: 1.4; }
