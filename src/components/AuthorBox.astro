---
/* Credibility block, sitting where the competitors put theirs — directly under
   the #1 pick, before the advertorial.

   A named person, as competitors do — but a real one. Sam runs the research
   and writes the rankings, so his name goes on them. Everything in the bio is
   true of what actually happens on this page: sourcing, method, disclosure.

   byline/role/bio/points are props, so a different real author can be set per
   page. What must never go here is an invented person.
*/
export interface Props {
  byline?: string;
  role?: string;
  bio?: string;
  points?: string[];
}
const {
  byline = "Sam Dullroy",
  role = "Founder & lead researcher, The Life Insider · Brisbane, Australia",
  bio = "I build these rankings from manufacturer specifications, live retail listings and published customer data — then publish the method, the sources and the cons next to the verdict. No paid placements, and no test results I did not actually run.",
  points = [
    "Every figure is the maker's published claim or a live listing, cited as such",
    "Cons published on all five picks, including the one I rank first",
    "I earn a commission if you buy through my links — it never changes a ranking",
  ],
} = Astro.props;
---

<aside class="author-box">
  <div class="ab-mark" aria-hidden="true">SD</div>

  <div class="ab-body">
    <div class="ab-name">{byline}</div>
    <div class="ab-role">{role}</div>
    <p class="ab-bio">{bio}</p>

    <ul class="ab-points">
      {points.map((p) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m20 6-11 11-5-5" />
          </svg>
          <span>{p}</span>
        </li>
      ))}
    </ul>

    <a class="ab-link" href="/how-we-rate/">Read our full scoring method →</a>
  </div>
</aside>
