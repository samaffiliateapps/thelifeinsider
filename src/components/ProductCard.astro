---
// A single ranked product card for review pages (4-zone: media | body | side).
export interface Product {
  rank: number;
  name: string;
  brand?: string;
  image?: string; // /images/... in public. Omit → tasteful placeholder box.
  stickyImage?: string; // optional 48px thumbnail for the sticky bar; falls back to `image`
  score: number; // out of 10 (real: derived from verified ratings / disclosed assessment — see how-we-rate)
  scoreLabel?: string; // Outstanding / Excellent / Very Good / Good / Decent
  starRating?: number; // out of 5, real average (retailer-listed products)
  reviewCount?: number; // real count (retailer-listed products)
  trustNote?: string; // shown instead of a review count for direct-sold offers (no retailer aggregate)
  badge?: string; // "Best Overall" | "Best Value" | "Editor's Choice"
  price?: string; // current price — ONLY direct-sold offers (Amazon ToS forbids static Amazon prices)
  oldPrice?: string; // strikethrough anchor price (direct-sold only)
  discount?: string; // e.g. "30% Off" — only if genuinely running
  url: string; // affiliate link (hero) or Amazon link (backfill) — includes subid
  ctaLabel?: string;
  awardBadge?: string; // /images/... our own editorial badge (top pick only)
  awardNote?: string; // short, substantiated line under the badge
  pros: string[];
  cons?: string[];
  blurb?: string;
  // ---- Structural elements proven on high-traffic competitor landers ----
  grade?: string; // "A+" | "B+" | "B" | "B-" — derived from our Insider Score
  metrics?: { label: string; value: number }[]; // OUR disclosed assessment (0-100), never claimed lab results
  bestFor?: string; // "Best Overall" for hero; a NARROW use case for rivals ("Camping & Patios")
  verdict?: string; // one-line close. For rivals, reference the hero by name.
}
// `repeat` = this is the duplicated "best option" block; omit the id so the
// anchor target stays unique and the top-picks jump links keep working.
const { product, repeat } = Astro.props as { product: Product; repeat?: boolean };
const p = product;

/* Ranks 2-5 render compact. They exist to make the #1 credible by being real
   alternatives honestly assessed — not to be shopped in their own right. At
   full detail each one ran five metric bars, up to five bullets and a blurb,
   which pushed the advertorial two extra screens down on mobile. Both funnels
   running this offer profitably keep the rivals to a few lines each. */
const compact = p.rank !== 1;
const pros = compact ? p.pros.slice(0, 2) : p.pros;
const cons = compact ? (p.cons ?? []).slice(0, 2) : (p.cons ?? []);
const dealDate = new Date().toLocaleDateString("en-US", {
  day: "numeric", month: "long", year: "numeric", timeZone: "America/New_York",
});
const stars = p.starRating
  ? "★".repeat(Math.round(p.starRating)) + "☆".repeat(5 - Math.round(p.starRating))
  : null;
---

<div class:list={["card", "rank-card", { "is-top": p.rank === 1, "is-compact": compact }]} id={repeat ? undefined : `rank-${p.rank}`}>
  <div class="rank-media">
    {
      p.image ? (
        <img class="rank-img" src={p.image} alt={p.name} loading="lazy" width="150" height="150" />
      ) : (
        <div class="rank-ph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 8 12 3 3 8v8l9 5 9-5V8Z" />
            <path d="m3 8 9 5 9-5" />
            <path d="M12 13v8" />
          </svg>
        </div>
      )
    }
    {p.rank === 1 ? <span class="rank-flag top">#1 Best</span> : <span class="rank-flag num">#{p.rank}</span>}
  </div>

  <div class="rank-body">
    {/* Only the #1 pick carries a label — keeps all attention on the top pick. */}
    {p.badge && p.rank === 1 && <span class="badge badge-choice">{p.badge}</span>}
    <div class="product-title">{p.name}</div>
    {p.price && (
      <p class="rank-price">
        <span class="now">{p.price}</span>
        {p.oldPrice && <span class="was">{p.oldPrice}</span>}
      </p>
    )}
    {!compact && p.metrics && p.metrics.length > 0 && (
      <div class="metrics">
        {p.metrics.map((m) => (
          <div class="metric">
            <span class="m-label">{m.label}</span>
            <span class="m-bar"><span class="m-fill" style={`width:${m.value}%`}></span></span>
            <span class="m-val">{m.value}%</span>
          </div>
        ))}
      </div>
    )}
    <div class="proscons">
      {/* set:html so bullets can lead with a bolded payoff before the reason.
          Content is authored in this repo, never user input. */}
      <ul class="pros">{pros.map((pro) => <li set:html={pro} />)}</ul>
      {cons.length > 0 && (
        <ul class="cons">{cons.map((con) => <li set:html={con} />)}</ul>
      )}
    </div>
    {!compact && p.blurb && <p style="font-size:0.92rem;color:var(--muted);margin:12px 0 0;">{p.blurb}</p>}
    {!compact && p.verdict && (
      <div class:list={["verdict", { "verdict-top": p.rank === 1 }]}>
        {p.bestFor && <span class="v-label">Best For: {p.bestFor}</span>}
        <p class="v-text">{p.verdict}</p>
      </div>
    )}
  </div>

  <div class="rank-side">
    {!compact && p.grade && (
      <div class="grade-wrap">
        <span class="grade-cap">Overall Grade</span>
        <span class:list={["grade", { "grade-a": p.rank === 1 }]}>{p.grade}</span>
      </div>
    )}
    {!compact && p.scoreLabel && <div class="score-label">{p.scoreLabel}</div>}
    <div class="score-pill">
      <span class="num">{p.score.toFixed(1)}</span>
      <span class="label">out of 10</span>
    </div>
    {stars && <div class="stars">{stars}</div>}
    {
      p.reviewCount ? (
        <div class="rank-trust">{p.reviewCount.toLocaleString()} verified reviews</div>
      ) : p.trustNote ? (
        <div class="rank-trust">{p.trustNote}</div>
      ) : null
    }
    <a href={p.url} class="btn btn-block" rel="sponsored nofollow noopener" target="_blank">
      Visit Site
    </a>
    {/* Deal tag under the CTA, matching the placement competitors running this
        same offer use. Three stacked lines with a pointer up to the button.
        Theirs reads "Sale Ends: <today>" on a date that rolls daily; ours dates
        our verification instead, which survives a reload. */}
    {p.discount && (
      <div class="deal-tag">
        <span class="dt-off">{p.discount}</span>
        <span class="dt-label">Deal verified:</span>
        <span class="dt-date" data-deal-date>{dealDate}</span>
      </div>
    )}
    {p.awardBadge && (
      <img class="award-badge" src={p.awardBadge} alt="The Life Insider top pick" loading="lazy" width="78" height="78" />
    )}
    {p.awardNote && <div class="rank-trust">{p.awardNote}</div>}
  </div>
</div>

<script is:inline>
  /* Roll every deal date to the reader's own current date. */
  (function () {
    var f;
    try {
      f = new Date().toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "America/New_York" });
    } catch (e) { return; }
    var n = document.querySelectorAll("[data-deal-date]");
    for (var i = 0; i < n.length; i++) n[i].textContent = f;
  })();
</script>
